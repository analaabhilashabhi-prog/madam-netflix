# Copy to .env and fill in. .env is gitignored and must never be committed.

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/madam-netflix?retryWrites=true&w=majority

PORT=5173

# Loopback only. Set to 0.0.0.0 to expose the site on your local network.
HOST=127.0.0.1

# Secret profile PIN — 4 digits. Checked server-side, never shipped to the
# browser. Set the real value in .env only; this file is committed.
SECRET_PIN=

# Shared passphrase for the whole site. Leave empty for local use.
# REQUIRED as soon as HOST is anything but loopback — the server refuses to
# start otherwise, because every video here is an unlisted link and the link
# is the secret.
SITE_PASSPHRASE=

# Signing key for session tokens. Falls back to a hash of MONGODB_URI,
# which means rotating the database password also invalidates sessions.
JWT_SECRET=

# Seed admin account, used only when the admin collection is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
